{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.starmani/starmani",
  "title": "StarMani",
  "description": "Vedic astrology calculations: birth charts, dashas, transits, compatibility and Panchang.",
  "version": "0.2.1",
  "websiteUrl": "https://starmani.com/developers",
  "repository": {
    "url": "https://github.com/starmani-ai/plugins",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://starmani.com/icons/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.starmani.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer followed by your StarMani API key (sm_live_...), from https://starmani.com/developers/keys",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Your StarMani API key (starts with sm_live_)",
              "isRequired": true,
              "isSecret": true,
              "format": "string"
            }
          }
        }
      ]
    }
  ]
}
