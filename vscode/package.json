{
  "name": "starmani",
  "displayName": "StarMani",
  "description": "Connect Vedic astrology tools to your AI agent using your StarMani account.",
  "version": "0.3.0",
  "publisher": "starmani",
  "license": "MIT",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "astrology",
    "vedic",
    "starmani"
  ],
  "icon": "assets/icon.png",
  "homepage": "https://starmani.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/starmani-ai/plugins.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/starmani-ai/plugins/issues"
  },
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onMcpServerDefinitionProvider:starmani.mcp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "starmani.setApiKey",
        "title": "StarMani: Connect with API Key"
      },
      {
        "command": "starmani.disconnect",
        "title": "StarMani: Remove Saved API Key"
      },
      {
        "command": "starmani.openAccount",
        "title": "StarMani: Open Account and API Keys"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "starmani.mcp",
        "label": "StarMani"
      }
    ],
    "configuration": {
      "title": "StarMani",
      "properties": {
        "starmani.mcpUrl": {
          "type": "string",
          "default": "https://api.starmani.com/mcp",
          "scope": "application",
          "markdownDescription": "HTTPS MCP endpoint. Keys are stored separately for each endpoint. Changing this requires connecting again."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies --out ../dist/starmani-0.3.0.vsix"
  }
}
